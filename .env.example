# Smart Knowledge Base for Agents - Environment Configuration

# Service Configuration
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data_storage

# LLM Provider Configuration
# Supported providers: groq, opencode, openai
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here

# OpenCode Provider (for official evaluation / submission)
# LLM_PROVIDER=opencode
# LLM_BASE_URL=https://opencode.ai/inference/openai/v1/chat/completions
# LLM_MODEL=deepseek-v4.1-flash
# LLM_API_KEY=your_opencode_api_key_here

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Contrastive Evidence Coverage (CEC) Parameters
# Global evidence cap; query facets and breadth determine the per-query cap.
MAX_EVIDENCE_CHUNKS=12
# Fraction of facet terms required to count that facet as covered.
MIN_COVERAGE_THRESHOLD=0.50
MAX_DOC_CANDIDATES=4
MAX_BROAD_DOC_CANDIDATES=8
CHUNK_SIZE_CHARS=750
CHUNK_OVERLAP_CHARS=100
DETERMINISTIC_EXTRACTION_LIMIT_PAGES=500
